{
  "name": "personal-productivity-hub",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w @pph/shared && npm run build -w @pph/web",
    "start": "npm run start -w @pph/server",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web && tsc -p e2e && tsc -p apps/desktop",
    "test": "vitest run",
    "test:bdd": "tsx scripts/test-bdd.ts",
    "desktop:build": "npm run build -w @pph/desktop",
    "desktop:start": "npm run start -w @pph/desktop",
    "desktop:smoke": "npm run smoke -w @pph/desktop",
    "desktop:dist": "npm run dist -w @pph/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
